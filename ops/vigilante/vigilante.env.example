# /etc/vigilante.env - configuracion del vigilante (lo lee systemd). No pongas claves aqui: el vigilante lee la clave LIMITADA de phoenix.conf.
BACKEND_DIR=/opt/fondo/backend
# DB_PATH=/opt/fondo/backend/fondo.db
# HALT_FILE=/opt/fondo/backend/HALT

# Tope de sats que pueden salir de phoenixd en 24 h, aunque cada pago este "explicado". El backend ya limita los reclamos
# (DAILY_CLAIM_CAP; en takepower.world, 50000 al dia): este tope va un poco por encima para que la operacion normal nunca lo toque.
MAX_OUTFLOW_24H_SATS=60000

# Minutos que debe llevar un reclamo en 'pending' antes de avisarte
PENDING_ALERT_MIN=10

# Avisos al celular con ntfy (app gratuita ntfy.sh). Pon aqui la URL de TU tema, con un nombre largo y aleatorio, p. ej.:  https://ntfy.sh/baul-<texto-largo-al-azar>
NOTIFY_URL=

# Latido: URL que se visita cada minuto cuando todo va bien (p. ej. un chequeo de healthchecks.io). Si deja de llegar, ese servicio te avisa.
HEARTBEAT_URL=
