# /etc/njalla-pay.env  (root, permisos 600). Nunca en el .env del backend.
# El token se crea en Njalla LIMITADO a:
#   - las IP del servidor (IPv4 e IPv6: el servidor puede salir por IPv6)
#   - los metodos get-balance y add-payment (nada mas: asi no puede tocar dominios, DNS ni servidores)
# El programa lo comprueba con: node njalla-pay.js --probar-token  (list-domains debe fallar)
NJALLA_API_TOKEN=pon_aqui_el_token_restringido
