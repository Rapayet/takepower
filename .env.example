# ============================================
# takepower.world - variables del backend (backend/BACKEND-index.js -> /opt/fondo/backend/index.js)
# ============================================
# Copia este archivo a .env y pon tus valores. NUNCA subas .env a git.
# En el servidor: /opt/fondo/backend/.env, dueno root, grupo fondo, permisos 640 (el backend lo lee; no lo puede cambiar).

# --- phoenixd (nodo Lightning) ---
PHOENIX_URL=http://127.0.0.1:9740
# Clave completa (puede pagar): solo la usa el backend para pagar reclamos ya validados.
PHOENIX_PASSWORD_FULL=pon_aqui_http-password_de_phoenix.conf
# Clave limitada (solo leer y crear invoices): para todo lo demas.
PHOENIX_PASSWORD_LIMITED=pon_aqui_http-password-limited-access_de_phoenix.conf
# nodeId del propio nodo (66 hex): el backend comprueba que phoenixd es este nodo y rechaza invoices dirigidos a si mismo.
OWN_NODE_ID=pon_aqui_el_nodeId_de_tu_phoenixd

# --- Reclamos y donaciones ---
# Un solo interruptor para reclamos y donaciones. Sin OWN_NODE_ID valido, TURNSTILE_SECRET y PHOENIX_PASSWORD_FULL se quedan cerrados aunque diga true.
CLAIMS_ENABLED=false
# Cada reclamo paga EXACTAMENTE esto (el invoice debe ser de este monto, de la red principal y no hacia el propio nodo).
CLAIM_AMOUNT=10000
CLAIM_INTERVAL_DAYS=21
# Tope de sats que pueden salir por reclamos en 24 h.
DAILY_CLAIM_CAP=50000
MIN_DONATION=20000
MAX_FUND=100000000
# Reserva de operacion (no se reparte): el mayor entre MINIMUM sats y PERCENT % del saldo.
OPERATIONS_RESERVE_PERCENT=7
OPERATIONS_RESERVE_MINIMUM=37500

# --- Cloudflare Turnstile (anti-spam). Si falta, los reclamos y donaciones fallan cerrados. ---
TURNSTILE_SECRET=pon_aqui_tu_clave_secreta_de_turnstile

# --- Servidor ---
PORT=3000
# Solo nginx, en la misma maquina, llega a la app.
BIND_HOST=127.0.0.1
DB_PATH=./fondo.db
# Si este archivo existe no sale ningun pago (lo crea el vigilante, el freno interno o el operador).
HALT_FILE=/opt/fondo/backend/HALT

# --- Opcionales (valores por defecto) ---
# FETCH_TIMEOUT_MS=8000
# PAY_TIMEOUT_MS=30000
# RECONCILE_INTERVAL_MS=60000
# VERIFY_INTERVAL_MS=300000
