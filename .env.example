# ============================================
# takepower.world — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Lightning node (LNbits / phoenixd)
LNBITS_URL=http://localhost:5000
LNBITS_ADMIN_KEY=your_admin_key_here
LNBITS_INVOICE_KEY=your_invoice_key_here

# Server
PORT=3000

# Database path
DB_PATH=./fondo.db

# Cloudflare Turnstile (anti-spam)
TURNSTILE_SECRET=your_turnstile_secret_key_here

# Fund parameters
CLAIM_AMOUNT=1000
CLAIM_INTERVAL_DAYS=21
MIN_DONATION=10000
MAX_FUND=100000000
OPERATIONS_RESERVE_PERCENT=7
OPERATIONS_RESERVE_MINIMUM=37500
